<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Opening a recording at the moment that matched asks QuickTime Player to go there (macOS asks you once); the
	     launcher's system commands and Focus ask System Events and browsers the same way. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- My Schedule (the launcher's calendar): the hardened runtime needs this before macOS will even ask. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
